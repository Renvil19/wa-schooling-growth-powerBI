expression CensusRaw =
		let
		    // WA Dept of Education Semester 1 census summaries 2020-2026 (data/wa_census_2020_2026.csv),
		    // embedded so the report refreshes on any computer without a file path
		    Source = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    Renamed = Table.RenameColumns(Promoted, {{"year", "Year"}, {"sector", "Sector"}, {"schools", "Schools"}, {"kindergarten", "Kindergarten"}, {"pre_primary", "Pre-primary"}, {"years_1_6", "Years 1-6"}, {"years_7_10", "Years 7-10"}, {"years_11_12", "Years 11-12"}, {"total", "Total"}, {"metro_schools", "Metro Schools"}, {"metro_students", "Metro Students"}, {"country_schools", "Country Schools"}, {"country_students", "Country Students"}}),
		    Typed = Table.TransformColumnTypes(Renamed, {{"Year", Int64.Type}, {"Sector", type text}, {"Schools", Int64.Type}, {"Kindergarten", Int64.Type}, {"Pre-primary", Int64.Type}, {"Years 1-6", Int64.Type}, {"Years 7-10", Int64.Type}, {"Years 11-12", Int64.Type}, {"Total", Int64.Type}, {"Metro Schools", Int64.Type}, {"Metro Students", Int64.Type}, {"Country Schools", Int64.Type}, {"Country Students", Int64.Type}})
		in
		    Typed
	lineageTag: 2f9af7e2-68c6-4263-a1a9-309720747ec5

	annotation PBI_ResultType = Table

expression SchoolsRaw =
		let
		    // Alphabetical list of WA schools, Semester 1 2026 census, cleaned (data/wa_schools_2026.csv)
		    Source = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    Renamed = Table.RenameColumns(Promoted, {{"code", "Code"}, {"school", "School"}, {"suburb", "Suburb"}, {"region", "Region"}, {"sector", "Sector"}, {"type", "Type"}, {"students", "Students"}, {"k", "K"}, {"pp", "PP"}, {"y1", "Y1"}, {"y2", "Y2"}, {"y3", "Y3"}, {"y4", "Y4"}, {"y5", "Y5"}, {"y6", "Y6"}, {"y7", "Y7"}, {"y8", "Y8"}, {"y9", "Y9"}, {"y10", "Y10"}, {"y11", "Y11"}, {"y12", "Y12"}, {"ungraded", "Ungraded"}}),
		    Typed = Table.TransformColumnTypes(Renamed, {{"Code", type text}, {"School", type text}, {"Suburb", type text}, {"Region", type text}, {"Sector", type text}, {"Type", type text}, {"Students", Int64.Type}, {"K", Int64.Type}, {"PP", Int64.Type}, {"Y1", Int64.Type}, {"Y2", Int64.Type}, {"Y3", Int64.Type}, {"Y4", Int64.Type}, {"Y5", Int64.Type}, {"Y6", Int64.Type}, {"Y7", Int64.Type}, {"Y8", Int64.Type}, {"Y9", Int64.Type}, {"Y10", Int64.Type}, {"Y11", Int64.Type}, {"Y12", Int64.Type}, {"Ungraded", Int64.Type}})
		in
		    Typed
	lineageTag: dc920481-d509-424d-9bf0-72ebf4171b22

	annotation PBI_ResultType = Table

