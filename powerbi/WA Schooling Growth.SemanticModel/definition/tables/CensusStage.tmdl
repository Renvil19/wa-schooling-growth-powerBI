		sourceColumn: Students

		annotation SummarizationSetBy = User

	partition CensusStage = m
		mode: import
		source =
				let
				    Source = CensusRaw,
				    Kept = Table.SelectColumns(Source, {"Year", "Sector", "Kindergarten", "Pre-primary", "Years 1-6", "Years 7-10", "Years 11-12"}),
				    Unpivoted = Table.UnpivotOtherColumns(Kept, {"Year", "Sector"}, "Stage", "Students"),
				    WithOrder = Table.AddColumn(Unpivoted, "StageOrder", each List.PositionOf({"Kindergarten", "Pre-primary", "Years 1-6", "Years 7-10", "Years 11-12"}, [Stage]), Int64.Type),
				    Typed = Table.TransformColumnTypes(WithOrder, {{"Students", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table

